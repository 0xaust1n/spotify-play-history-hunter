{
  "name": "spotify-streaming-history-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bun run dev:api\" \"bun run dev:web\"",
    "dev:api": "bun --watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "import": "bun run scripts/import-spotify.ts",
    "migrate": "bun run scripts/import-spotify.ts --reset",
    "start": "bun run server/index.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "pg": "latest",
    "react": "latest",
    "react-day-picker": "^10.0.0",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "^1.3.13",
    "@types/pg": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tailwindcss": "^4.3.0",
    "typescript": "latest"
  }
}
